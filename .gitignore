# Allowlist: everything is ignored unless listed below. Game files (.xex,
# .iso), logs, traces and build output must never be committed.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/CMakeLists.txt
!/CMakePresets.json
!/README.md
!/LICENSE
!/build.sh
!/espgaluda2_recomp_manifest.toml
!/espgaluda2_recomp*_functions.toml
!/src/
!/generated/
!/sdk-patches/
!/renut-patches/
!/packaging/
!/WORKLOG.md
!/tools/
!/cmake/
!/docs/
!/LICENSE-GPL-3.0
!/prebuilt/

*.xex
*.iso
*.log
*.bak*
__pycache__/
__pycache__/
