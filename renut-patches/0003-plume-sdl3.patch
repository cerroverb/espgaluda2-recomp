# espgaluda2-recomp: plume's SDL Vulkan path (PLUME_SDL_VULKAN_ENABLED, written for SDL2) in its SDL3 form, selected
# with PLUME_SDL3_TARGET (headers only), for the ReXGlue SDK's SDL3 window (sdk-patches/0006): Wayland or X11.
diff --git a/app/thirdparty/plume/CMakeLists.txt b/app/thirdparty/plume/CMakeLists.txt
index 9b9ba24..c8591c0 100644
--- a/app/thirdparty/plume/CMakeLists.txt
+++ b/app/thirdparty/plume/CMakeLists.txt
@@ -36,7 +36,12 @@ if(WIN32)
 endif()
 
 # Enable SDL Vulkan support
-if(PLUME_SDL_VULKAN_ENABLED)
+# espgaluda2-recomp (renut-patches/0003): PLUME_SDL3_TARGET names an SDL3 target the parent project already has
+# (the ReXGlue SDK's); plume's SDL path then uses SDL3 (PLUME_SDL3).
+set(PLUME_SDL3_TARGET "" CACHE STRING "An existing SDL3 target for the SDL Vulkan integration (SDL3 instead of SDL2)")
+if(PLUME_SDL_VULKAN_ENABLED AND PLUME_SDL3_TARGET)
+    set(SDL2_INCLUDE_DIRS "$<TARGET_PROPERTY:${PLUME_SDL3_TARGET},INTERFACE_INCLUDE_DIRECTORIES>")
+elseif(PLUME_SDL_VULKAN_ENABLED)
     if (NOT TARGET SDL2::SDL2)
         find_package(SDL2 REQUIRED)
     else()
@@ -103,6 +108,11 @@ endif()
 if(PLUME_SDL_VULKAN_ENABLED)
     target_compile_definitions(plume PUBLIC PLUME_SDL_VULKAN_ENABLED)
     target_include_directories(plume PUBLIC ${SDL2_INCLUDE_DIRS})
+    if(PLUME_SDL3_TARGET)
+        target_compile_definitions(plume PUBLIC PLUME_SDL3)
+        # Headers only: the parent's SDL3 instance (the SDK runtime's) provides the functions, so the window plume
+        # is given and the one SDL knows are the same; linking another static copy here would split them.
+    endif()
 endif()
 
 if(PLUME_D3D12_AGILITY_SDK_ENABLED)
diff --git a/app/thirdparty/plume/plume_render_interface_types.h b/app/thirdparty/plume/plume_render_interface_types.h
