+  double Observe() {
+    namespace dt = rex::ui::display_timing;
+    if (disabled_) {
+      return 0.0;
+    }
+    if (!dt::IsQueuedPresentMode()) {
+      locked_ = false;
+      good_samples_ = 0;
+      return 0.0;
+    }
+    const dt::Sample sample = dt::Latest();
+    if (sample.sequence == last_sequence_) {
+      return 0.0;
+    }
+    last_sequence_ = sample.sequence;
+    const double d = double(sample.shown_ns - sample.submit_ns) / 1e6;
+    if (d < 0.0 || d > 4.0 * frame_ms_) {
+      return 0.0;
+    }
+    ++samples_;
+    d_sum_ += d;
+
+    double e = d - margin_ms_;
+    bool late = false;
+    if (e > 0.5 * frame_ms_) {
+      // Shown a refresh later than aimed for: a missed refresh while locked,
+      // otherwise simply the shorter way round.
+      e -= frame_ms_;
+      late = locked_;
+    }
+    if (late) {
+      ++late_samples_;
+      if (margin_ms_ < kMaxMarginMs) {
+        margin_ms_ = std::min(kMaxMarginMs, margin_ms_ + 0.5);
+        REXLOG_INFO("vsync_display_lock: missed a refresh, margin now {:.2f} ms", margin_ms_);
+      }
+      stable_samples_ = 0;
+    }
+
+    const double adjust = std::clamp(e * kGain, -kMaxStepMs, kMaxStepMs);
+
+    if (std::abs(e) < 1.0) {
+      if (!locked_ && ++good_samples_ >= 30) {
+        locked_ = true;
+        REXLOG_INFO("vsync_display_lock: locked to the display, margin {:.2f} ms", margin_ms_);
+      }
