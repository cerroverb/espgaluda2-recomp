@@ -0,0 +1,36 @@
+/**
+ ******************************************************************************
+ * ReXGlue: when presented guest frames were actually shown on the display.   *
+ ******************************************************************************
+ * Published by the presenter (VK_KHR_present_wait) and read by the guest      *
+ * vblank timer to lock its phase to the display's refresh.                    *
+ ******************************************************************************
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::ui::display_timing {
+
+struct Sample {
+  // Incremented for every published sample, 0 if none yet.
+  uint64_t sequence = 0;
+  // Steady clock nanoseconds when the image was queued for presentation.
+  int64_t submit_ns = 0;
+  // Steady clock nanoseconds when the image was observed as shown.
+  int64_t shown_ns = 0;
+};
+
+int64_t NowNs();
+
+// Whether the current swapchain queues images to the display's refresh (FIFO,
+// FIFO relaxed or mailbox). Immediate presentation has no refresh grid to lock
+// to, and samples are not meaningful for the vblank lock then.
+void SetQueuedPresentMode(bool queued);
+bool IsQueuedPresentMode();
+
+void Publish(int64_t submit_ns, int64_t shown_ns);
+Sample Latest();
+
+}  // namespace rex::ui::display_timing
