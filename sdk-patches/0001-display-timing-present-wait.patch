+  uint64_t samples_ = 0;
+  uint64_t late_samples_ = 0;
+  uint32_t good_samples_ = 0;
+  uint32_t stable_samples_ = 0;
+  bool locked_ = false;
+  bool ever_locked_ = false;
+  bool disabled_ = false;
+  bool applying_ = false;
+};
