+      } else if (failed && ++consecutive_failures >= kMaxConsecutiveFailures) {
+        REXLOG_WARN("VulkanPresenter: present wait keeps failing, display timing disabled");
+        std::lock_guard<std::mutex> lock(mutex_);
+        disabled_ = true;
+        return;
+      }
+    }
+  }
