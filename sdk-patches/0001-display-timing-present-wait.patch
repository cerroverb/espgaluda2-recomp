+  // poll to finish, so the swapchain is never used after this returns.
+  void ForgetSwapchains() {
+    std::lock_guard<std::mutex> poll_lock(poll_mutex_);
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++generation_;
+    pending_.valid = false;
+  }
+
+  void Stop() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+      pending_.valid = false;
+      cv_.notify_all();
+    }
+    if (thread_.joinable()) {
+      thread_.join();
+    }
