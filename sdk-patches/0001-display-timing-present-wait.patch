index 00000000..8f0569d7
--- /dev/null
+++ b/thirdparty/rexglue-sdk/src/ui/display_timing.cpp
@@ -0,0 +1,45 @@
+/**
+ ******************************************************************************
+ * ReXGlue: when presented guest frames were actually shown on the display.   *
+ ******************************************************************************
+ */
+
+#include <rex/ui/display_timing.h>
+
+#include <atomic>
+#include <chrono>
+#include <mutex>
+
+namespace rex::ui::display_timing {
+
+namespace {
+std::mutex sample_mutex;
+Sample latest_sample;
+std::atomic<bool> queued_present_mode{false};
+}  // namespace
+
+int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+void SetQueuedPresentMode(bool queued) {
+  queued_present_mode.store(queued, std::memory_order_release);
+}
+
+bool IsQueuedPresentMode() { return queued_present_mode.load(std::memory_order_acquire); }
+
+void Publish(int64_t submit_ns, int64_t shown_ns) {
+  std::lock_guard<std::mutex> lock(sample_mutex);
+  ++latest_sample.sequence;
+  latest_sample.submit_ns = submit_ns;
+  latest_sample.shown_ns = shown_ns;
+}
+
+Sample Latest() {
+  std::lock_guard<std::mutex> lock(sample_mutex);
+  return latest_sample;
+}
+
+}  // namespace rex::ui::display_timing
