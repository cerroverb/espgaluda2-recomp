+  static constexpr int64_t kPollIntervalNs = 200000;   // 0.2 ms
+  static constexpr int64_t kGiveUpNs = 100000000;      // 100 ms per present
+  static constexpr uint32_t kMaxConsecutiveFailures = 120;
