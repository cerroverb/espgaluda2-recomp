+    if (disabled_) {
+      return;
+    }
+    pending_ = {device, queue_family, swapchain, present_id, submit_ns, generation_, true};
+    if (!thread_.joinable()) {
+      stop_ = false;
+      thread_ = std::thread([this]() { Run(); });
+    }
+    cv_.notify_one();
+  }
