+      REXLOG_WARN(
+          "vsync_display_lock: no stable lock after {} frames (variable or non-multiple refresh "
+          "rate?), using the plain timer",
+          samples_);
+      return 0.0;
+    }
+    ever_locked_ |= locked_;
+
+    if (samples_ % 600 == 0) {
+      REXLOG_INFO(
+          "vsync_display_lock: {} frames, applied={}, locked={}, mean present-to-shown {:.2f} "
+          "ms, margin {:.2f} ms, missed refreshes {}",
+          samples_, applying_, locked_, d_sum_ / 600.0, margin_ms_, late_samples_);
+      d_sum_ = 0.0;
+    }
+    return adjust;
+  }
