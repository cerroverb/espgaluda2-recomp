+namespace {
+// espgaluda2-recomp (sdk-patches/0007): whether the Wayland display's socket hung up (SDL's wayland driver only).
+bool WaylandConnectionLost() {
+#if REX_PLATFORM_GNU_LINUX
+  auto* display = static_cast<struct wl_display*>(SDL_GetPointerProperty(
+      SDL_GetGlobalProperties(), SDL_PROP_GLOBAL_VIDEO_WAYLAND_WL_DISPLAY_POINTER, nullptr));
+  if (!display) {
+    return false;
+  }
+  pollfd fd{wl_display_get_fd(display), POLLIN, 0};
+  return poll(&fd, 1, 0) > 0 && (fd.revents & (POLLHUP | POLLERR)) != 0;
+#else
+  return false;
+#endif
+}
