+  void ProcessQuitRequest();
+  static bool SDLCALL WatchEvent(void* userdata, SDL_Event* event);
 
   std::unordered_map<SDL_WindowID, WindowSDL*> windows_;
   uint32_t wakeup_event_type_ = 0;
