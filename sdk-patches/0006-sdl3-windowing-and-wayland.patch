+uint32_t WindowSDL::GetLatestDpiImpl() const {
+  float scale = sdl_window_ ? SDL_GetWindowDisplayScale(sdl_window_)
+                            : SDL_GetDisplayContentScale(SDL_GetPrimaryDisplay());
+  if (scale <= 0.0f) {
+    return GetMediumDpi();
+  }
+  return uint32_t(scale * float(GetMediumDpi()) + 0.5f);
